% RULES

% Rule 1:
% Find instructor of a course

course_instructor(Course, Instructor) :-
    instructor(Course, Instructor).

% Rule 2:
% Find location of a course

course_location(Course, Room) :-
    location(Course, Room).

% Rule 3:
% Find complete timetable information
% for a particular course

course_schedule(Course, Day, Time, Instructor, Room) :-
    timetable(Day, Time, Course, Instructor, Room).

% Rule 4:
% Find all classes conducted by an instructor

teacher_class(Instructor, Course, Day, Time, Room) :-
    timetable(Day, Time, Course, Instructor, Room).

% Rule 5:
% Find classes conducted on a particular day

day_schedule(Day, Course, Time, Instructor, Room) :-
    timetable(Day, Time, Course, Instructor, Room).

% Rule 6:
% Check whether a course is available

course_available(Course) :-
    course(Course).

% Rule 7:
% Check whether an instructor teaches a particular course

teaches(Instructor, Course) :-
    instructor(Course, Instructor).

% Rule 8:
% Find the room in which a teacher conducts a class

teacher_room(Instructor, Room) :-
    timetable(_, _, _, Instructor, Room).

% Rule 9:
% Find courses conducted in a particular room

room_course(Room, Course) :-
    timetable(_, _, Course, _, Room).

% Rule 10:
% Find courses conducted at a particular time

class_at_time(Time, Course, Instructor, Room) :-
    timetable(_, Time, Course, Instructor, Room).


%Example 
%course_instructor(dbms, X).
%course_location(dbms, X).
%course_schedule(dbms, Day, Time, Instructor, Room).
%day_schedule(monday, Course, Time, Instructor, Room).
%course_available(ai).
%class_at_time('10:00-11:00', Course, Instructor, Room).

